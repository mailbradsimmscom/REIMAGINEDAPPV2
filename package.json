{
  "name": "reimaginedappv2",
  "version": "0.1.0",
  "private": true,
  "description": "Enterprise app scaffold (Node 20, ESM)",
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "node ./src/start.js",
    "dev:web": "node ./src/start.js",
    "start": "node ./src/start.js",
    "test": "npm run test:unit && npm run test:integration",
    "test:unit": "node --test tests/unit/",
    "test:integration": "node --test tests/integration/",
    "test:contract": "node --test tests/contract/",
    "test:nightly": "node --test tests/nightly/",
    "test:dip": "node --test tests/integration/dip/",
    "test:golden": "node --test tests/integration/golden/",
    "test:python": "cd python-sidecar && pytest tests -v",
    "test:python:cov": "cd python-sidecar && pytest tests -v --cov=app",
    "test:e2e": "playwright test tests/e2e/",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:ui:all": "playwright test tests/nightly/ui-all.spec.js",
    "test:ui:all:headed": "playwright test tests/nightly/ui-all.spec.js --headed",
    "test:all": "npm run test:unit && npm run test:integration && npm run test:python && npm run test:e2e",
    "test:unit:cov": "c8 npm run test:unit",
    "test:discover-pages": "node scripts/discover-ui-pages.js",
    "test:check-coverage": "node scripts/check-ui-coverage.js",
    "test:baseline": "./tests/run-baseline.sh",
    "test:with-sidecar": "node tests/run-tests-with-sidecar.js",
    "test:watch": "node --test --watch tests/",
    "test:performance": "node scripts/performance-monitor.js",
    "test:ci": "npm run test:unit && npm run test:integration && npm run test:performance",
    "zod:coverage": "node scripts/zod-coverage.mjs",
    "graph:js": "npx depcruise src --output-type text > docs/app-deps.txt",
    "graph:py": "~/.local/bin/pydeps python-sidecar/app -T svg -o docs/sidecar-deps.svg --noshow",
    "graph:madge": "madge --extensions js --image docs/app-madge.png src",
    "graph:all": "npm run graph:madge && npm run graph:py",
    "docs:generate": "npm run graph:all && echo 'Dependency graphs generated in docs/'",
    "docs:clean": "rm -rf docs/auto && mkdir -p docs/auto/graphs",
    "docs:js": "documentation build \"src/**/*.js\" -f md -o docs/auto/js.md || true",
    "docs:routes": "node scripts/dump-routes.mjs > docs/auto/routes.mdx",
    "docs:deps:dot": "depcruise --include-only \"^src\" --output-type dot src | dot -Tsvg -o docs/auto/graphs/deps.svg",
    "docs:deps:page": "node scripts/deps-page.mjs",
    "docs:openapi": "node scripts/gen-openapi.mjs",
    "docs:all": "npm run docs:clean && npm run docs:js && npm run docs:routes && npm run docs:deps:dot && npm run docs:deps:page && npm run docs:openapi",
    "docs": "cd docs && npx mintlify dev --port 3100",
    "structurizr:generate": "node scripts/generate-structurizr.mjs && python3 scripts/generate-structurizr-sidecar.py && node scripts/combine-structurizr.mjs",
    "structurizr:push": "./scripts/push-structurizr.sh",
    "structurizr:full": "npm run structurizr:generate && npm run structurizr:push"
  },
  "dependencies": {
    "@langchain/core": "^0.3.77",
    "@langchain/langgraph": "^0.4.9",
    "@langchain/openai": "^0.6.13",
    "@pinecone-database/pinecone": "^6.1.2",
    "@supabase/supabase-js": "2.56.0",
    "acorn": "^8.15.0",
    "acorn-walk": "^8.3.4",
    "busboy": "^1.6.0",
    "cors": "^2.8.5",
    "csv-parse": "^6.1.0",
    "csv-parser": "^3.2.0",
    "csv-stringify": "^6.6.0",
    "csv-writer": "^1.6.0",
    "dotenv": "16.6.1",
    "express": "^5.1.0",
    "express-async-handler": "^1.2.0",
    "express-list-endpoints": "^7.1.1",
    "fast-glob": "^3.3.3",
    "helmet": "^8.1.0",
    "multer": "^2.0.2",
    "node-telegram-bot-api": "^0.66.0",
    "openai": "^5.19.1",
    "pdf-parse": "^2.2.9",
    "twilio": "^5.10.5",
    "uuid": "^11.1.0",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.34.0",
    "@playwright/test": "^1.55.0",
    "c8": "^10.1.2",
    "concurrently": "^9.0.0",
    "dependency-cruiser": "^17.0.1",
    "eslint": "^9.34.0",
    "globals": "^16.3.0",
    "madge": "^8.0.0",
    "mintlify": "^4.2.161",
    "supertest": "^7.1.4"
  }
}
